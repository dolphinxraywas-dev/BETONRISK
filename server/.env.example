PORT=3000
NODE_ENV=development
# Set this in your hosting provider's secret manager. Never commit the real token.
TELEGRAM_BOT_TOKEN=replace_with_botfather_token
# Comma-separated Telegram numeric user IDs permitted to act as host/admin.
HOST_TELEGRAM_IDS=replace_with_your_telegram_numeric_id
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key
# Optional: allow a specific deployed Mini App origin, e.g. https://yourname.github.io
ALLOWED_ORIGIN=https://yourname.github.io
